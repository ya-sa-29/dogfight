# Dogfight server environment variables
# Copy this file to .env and adjust values for your deployment.
# Never commit .env — it is gitignored. Secrets live in the platform secret store.

# Port the HTTP/WebSocket server listens on (default: 3000)
PORT=3000

# Node environment: development | production | test (default: development)
NODE_ENV=development

# Log level: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# Directory for NDJSON match logs (default: ./logs)
LOG_DIR=./logs

# Allowed WebSocket origins, comma-separated.
# Use "*" to allow all origins (local development only).
# In production, set specific origins, e.g.:
#   ALLOWED_ORIGINS=https://dogfight.example.com,https://www.dogfight.example.com
ALLOWED_ORIGINS=*

# Maximum concurrent WebSocket connections per client IP (default: 50)
MAX_CONNECTIONS_PER_IP=50

# Maximum number of rooms on the server (default: 100)
MAX_ROOMS=100

# Maximum number of players per room (default: 8)
MAX_PLAYERS_PER_ROOM=8

# Build-time version stamp (set by CI/CD, e.g. git SHA).
# Included in /health responses and client HUD.
# GIT_SHA=abc1234
