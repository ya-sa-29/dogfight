{
    "name": "dogfight",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "client",
        "server",
        "shared"
    ],
    "scripts": {
        "dev": "npm run dev --workspace=@dogfight/client",
        "build": "npm run build --workspace=@dogfight/client",
        "preview": "npm run preview --workspace=@dogfight/client",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.9"
    }
}